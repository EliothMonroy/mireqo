{
  "name": "mireqo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "pnpm --filter @mireqo/mobile dev",
    "android": "pnpm --filter @mireqo/mobile android",
    "ios": "pnpm --filter @mireqo/mobile ios",
    "lint": "eslint scripts --config apps/mobile/eslint.config.cjs && pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test scripts/*.test.mjs && pnpm -r --if-present test",
    "check": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run format:check && pnpm run test",
    "build": "pnpm --filter @mireqo/contracts build && pnpm --filter @mireqo/backend build",
    "test:integration": "pnpm --filter @mireqo/backend test:integration",
    "api": "pnpm --filter @mireqo/backend api",
    "worker": "pnpm --filter @mireqo/backend worker",
    "db:migrate": "pnpm --filter @mireqo/backend db:migrate",
    "db:seed": "pnpm --filter @mireqo/backend db:seed",
    "db:up": "docker compose -f infrastructure/compose.yaml up -d --wait db",
    "db:stop": "docker compose -f infrastructure/compose.yaml stop db",
    "db:test:up": "docker compose -f infrastructure/compose.yaml --profile test up -d --wait test-db",
    "db:reset": "node scripts/reset-db.mjs",
    "db:seed:demo": "pnpm --filter @mireqo/backend db:seed:demo"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
